# Copy to .env.local and fill in. Never commit real values.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
TMDB_API_READ_TOKEN=
# The production address in Vercel; product email links and the email job use it.
APP_URL=http://localhost:3000
# Resend. Sign-in links send through Supabase Auth's custom SMTP, from
# hello@mail.goodwordfriends.com; the app sends product email (step 7) through
# Resend's API with the same key. Set it in Vercel's production environment too.
EMAIL_API_KEY=
# Migrations and auth settings (Supabase Management API)
SUPABASE_ACCESS_TOKEN=
SUPABASE_PROJECT_REF=
